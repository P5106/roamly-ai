# Preferred: keep this key on the backend; do not prefix it with VITE_ for public builds.
OPENROUTER_API_KEY=your_openrouter_api_key
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional backend-only key for live hotel cards; NEVER use VITE_ prefix.
SERPAPI_API_KEY=
PORT=5000

# Leave empty for local development. For a deployed APK, use your backend HTTPS URL.
VITE_API_BASE_URL=
